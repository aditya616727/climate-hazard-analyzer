# MongoDB (matches docker-compose.yml)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=climate_hazards

# Optional: OpenAI-compatible API key enables the AI narrative + Q&A features.
# Without it the API falls back to deterministic, stats-only summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Rate limit applied per endpoint (slowapi)
RATE_LIMIT=30/minute
